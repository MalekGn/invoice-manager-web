generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GLOBAL_ADMIN
  COMPANY_ADMIN
  USER
}

model Company {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  users     User[]
  clients   Client[]
  suppliers Supplier[]
  products  Product[]
  invoices  Invoice[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String?
  name      String?
  bio       String?
  avatar    String?
  role      Role     @default(USER)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
}

model Client {
  id        String    @id @default(uuid())
  name      String
  email     String?
  address   String?
  vatNumber String?
  invoices  Invoice[]
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
}

model Supplier {
  id        String @id @default(uuid())
  name      String
  vatNumber String
  address   String
  email     String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
}

model Product {
  id            String  @id @default(uuid())
  name          String
  description   String?
  purchasePrice Float
  sellPrice     Float
  vatRate       Float
  stockQuantity Int
  category      String?
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
}

model Invoice {
  id             String        @id @default(uuid())
  customerName   String
  amount         Float
  vatAmount      Float?
  currency       String
  date           DateTime      @default(now())
  dueDate        DateTime?
  status         String
  type           String?       @default("sale")
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id])
  poNumber       String?
  jobNo          String?
  representative String?
  project        String?
  shipTo         String?
  notes          String?
  terms          String?
  items          InvoiceItem[]
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  description String
  quantity    Int
  price       Float
  vatRate     Float?
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}
